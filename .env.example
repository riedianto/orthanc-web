# =============================================
# ORTHANC PACS - Environment Variables
# Salin file ini menjadi .env dan isi nilainya
# =============================================

# --- Orthanc ---
ORTHANC_PASSWORD=orthanc

# --- HMS SQL Server ---
HMS_SQLSERVER_HOST=103.167.x.x
HMS_SQLSERVER_PORT=1433
HMS_SQLSERVER_DB=nama_database
HMS_SQLSERVER_USER=username_sql
HMS_SQLSERVER_PASSWORD=password_sql

# --- Identitas Faskes ---
INSTITUTION_NAME=RSUD Nama Rumah Sakit

# --- Webhook Notifikasi ke SIMRS (opsional) ---
SIMRS_WEBHOOK_URL=http://simrs-internal/api/radiology/notify

# --- Polling ---
POLL_INTERVAL_SECONDS=5
POLL_DAYS_BACK=1

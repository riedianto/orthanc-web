{
  "Name" : "Orthanc Server SIMRS",
  "StorageDirectory" : "/var/lib/orthanc/db",
  "IndexDirectory" : "/var/lib/orthanc/db",
  "TemporalUnstableInterval" : 60,


  "AdvancedStorage" : {
    "Enable" : true,
    "NamingScheme" : "{AccessionNumber}/{StudyInstanceUID}_{SOPInstanceUID}_{UUID}.dcm"
  },

  "StorageCompression" : false,
  "ConcurrentJobs" : 4,
  "MaximumStorageCacheSize" : 512,

  "HttpPort" : 8090,
  "DicomPort" : 4242,
  "DicomAet" : "ORTHANC",
  "DicomCheckCalledAet" : false,
  "DicomAlwaysAllowEcho" : true,
  "DicomAlwaysAllowStore" : true,
  "DicomAlwaysAllowFind" : true,
  "DicomAlwaysAllowGet" : true,
  "DicomAlwaysAllowMove" : true,
  "DicomAlwaysAllowFindWorklist" : true,
  "UnknownSopClassAccepted" : true,
  "DicomInstitutionName" : "RSU Artha Medica",

  "RemoteAccessAllowed" : true,
  "AuthenticationEnabled" : true,
  "HttpCors" : true,

  "RegisteredUsers" : {
    "orthanc" : "${ORTHANC_PASSWORD}"
  },

  "PostgreSQL" : {
    "Host" : "orthanc-postgres",
    "Port" : 5432,
    "Database" : "orthanc",
    "Username" : "orthanc",
    "Password" : "Orthanc2024!"
  },

  "DicomModalities" : {
    "SATUSEHAT" : [ "DCMROUTER", "dicom-router", 11112 ]
  },

  "DicomWeb" : {
    "Enable" : true,
    "Root" : "/dicom-web/"
  },

  "Worklists" : {
    "Enable" : true,
    "Database" : "/var/lib/orthanc/worklists"
  },

  "WebViewer" : {
    "Enable" : true
  },

  "OrthancExplorer2" : {
    "Enable" : true,
    "IsDefaultOrthancUI" : true,
    "UiOptions" : {
      "ViewersOrdering" : [
        "osimis-web-viewer"
      ]
    }
  },

  "Wsi" : {
    "Enable" : true,
    "LargeImageMemoryLimit" : 512,
    "Maxcores" : 2,
    "Threads" : 4
  },

  "Authorization" : {
    "Enable" : false
  },

  "LuaScripts" : [
    "/etc/orthanc/scripts/simrs_notifier.lua"
  ],

  "PythonScripts" : [
    "/etc/orthanc/scripts/simrs_notifier.py"
  ],

  "Jobs" : {
    "Enable" : true,
    "MaxCompletedJobs" : 10,
    "MaxJobs" : 100
  },

  "LeanAndDeleteOn" : true,

  "QueryRetrieve" : {
    "Enable" : true
  },

  "DicomCStore" : {
    "Enable" : true
  },

  "Verbosity" : "verbose",
  "TraceEnabled" : true,

  "HttpResponseHeaders" : {
    "Access-Control-Allow-Origin" : "*",
    "Access-Control-Allow-Credentials" : "true",
    "Access-Control-Allow-Methods" : "GET, POST, PUT, DELETE, OPTIONS",
    "Access-Control-Allow-Headers" : "Authorization, Content-Type, Accept, Origin"
  }
}
